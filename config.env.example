# CoReadingMCP 配置模板
# 复制为 config.env 后可覆盖默认值。没有私密信息时可以不创建 config.env。

# 阅读数据目录。留空时默认使用 D:\VCP\VCPToolBox\data\co-reading-mcp
CO_READING_DATA_DIR=

# 上游 co-reading-mcp 源码目录。留空时使用本插件 vendor\co-reading-mcp
CO_READING_VENDOR_DIR=

# VCP 单次返回最大字符数
CO_READING_MAX_RESULT_CHARS=80000

# 沉淀输出目录。留空时可在前端“沉淀路径”里临时填写。
CO_READING_OBSIDIAN_VAULT_DIR=
CO_READING_DAILY_NOTE_ROOT=
CO_READING_VCP_MEMORY_ROOT=
CO_READING_OBS_OUTPUT_DIR=

# 独立共读 Sidecar。仅在手动运行 node CoReadingSidecar.cjs / npm run sidecar 时使用。
CO_READING_SIDECAR_HOST=127.0.0.1
CO_READING_SIDECAR_PORT=8791

# Nova 接入。默认先走 6005 VCP OpenAI 兼容模型接口，失败后短探测 3100 bridge。
# 可选后端值：vcp、bridge、agent-assistant。agent-assistant 只在需要走 /v1/human/tool 时显式开启。
CO_READING_NOVA_BACKENDS=vcp,bridge
CO_READING_NOVA_VCP_URL=http://127.0.0.1:6005/v1/chat/completions
CO_READING_NOVA_AGENT_URL=http://127.0.0.1:6005/v1/human/tool
CO_READING_NOVA_AGENT_NAME=Nova
CO_READING_NOVA_AGENT_MAID=Nova
CO_READING_NOVA_AGENT_SESSION=coreading-reader
CO_READING_NOVA_AGENT_SESSION_SCOPE=book
CO_READING_NOVA_AGENT_INJECT_TOOLS=CoReadingMCP,AnySearch,JinaReader,FileOperator
CO_READING_NOVA_BRIDGE_URL=http://127.0.0.1:3100/v1/chat/completions
CO_READING_NOVA_MODEL=gpt-5.5
CO_READING_NOVA_TIMEOUT_MS=360000
CO_READING_NOVA_FALLBACK_TIMEOUT_MS=1500
CO_READING_NOVA_GUIDE_PATH=
CO_READING_NOVA_SKILL_PROMPTS_DIR=

# 前端本地书库扫描目录。默认 D:\书库。
CO_READING_LIBRARY_DIR=D:\书库

# 模拟书友圈：独立普通 OpenAI 兼容接口（与 Nova 的 VCP 通道分开）。
# URL 留空时书友评论功能整体处于未配置状态（不报错，前端开关置灰）。
# 示例：CO_READING_COMPANION_API_URL=https://api.example.com/v1/chat/completions
CO_READING_COMPANION_API_URL=
CO_READING_COMPANION_API_KEY=
CO_READING_COMPANION_MODEL=gpt-4o-mini
CO_READING_COMPANION_TIMEOUT_MS=60000
# personas 名单文件。留空时使用 prompts\companions\personas.json
CO_READING_COMPANION_PERSONAS_PATH=
