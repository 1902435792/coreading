# CoReadingMCP 配置模板
# 复制为 config.env 后可覆盖默认值。没有私密信息时可以不创建 config.env。

# 阅读数据目录。留空时默认使用 D:\VCP\VCPToolBox\data\co-reading-mcp
CO_READING_DATA_DIR=

# 上游 co-reading-mcp 源码目录。留空时使用本插件 vendor\co-reading-mcp
CO_READING_VENDOR_DIR=

# VCP 单次返回最大字符数
CO_READING_MAX_RESULT_CHARS=80000

# 独立共读 Sidecar。仅在手动运行 node CoReadingSidecar.cjs / npm run sidecar 时使用。
CO_READING_SIDECAR_HOST=127.0.0.1
CO_READING_SIDECAR_PORT=8791
